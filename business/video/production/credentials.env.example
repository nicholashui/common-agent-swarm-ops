# Copy to a secrets store or local .env (never commit real keys).
CASOPS_VIDEO_PRODUCTION_ENABLED=true
CASOPS_VIDEO_MEDIA_NETWORK=true

# Provider credentials (set the ones you use)
CASOPS_MEDIA_SORA_API_KEY=
# or OPENAI_API_KEY=
CASOPS_MEDIA_VEO_API_KEY=
# or GOOGLE_API_KEY=
CASOPS_MEDIA_RUNWAY_API_KEY=
# or RUNWAY_API_KEY=
CASOPS_MEDIA_ELEVENLABS_API_KEY=
# or ELEVENLABS_API_KEY=

# Optional endpoint overrides (must be https, or http://localhost for mocks)
# CASOPS_MEDIA_SORA_ENDPOINT=https://api.openai.com/v1/videos
# CASOPS_MEDIA_VEO_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
# CASOPS_MEDIA_RUNWAY_ENDPOINT=https://api.dev.runwayml.com/v1/image_to_video
# CASOPS_MEDIA_ELEVENLABS_ENDPOINT=https://api.elevenlabs.io/v1/text-to-speech
