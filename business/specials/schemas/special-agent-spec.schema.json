{
  "$id": "special-agent-spec.schema.json",
  "title": "Data-Only Special Agent Specification",
  "type": "object",
  "required": [
    "schema_version",
    "agent_id",
    "status",
    "role",
    "allowed_tools",
    "model_policy",
    "budget_policy",
    "prompt_reference",
    "rubric_reference",
    "critique_edges",
    "max_refinement_count",
    "production_activation_requested"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "agent_id": {
      "$ref": "#/$defs/CanonicalAgentId"
    },
    "status": {
      "type": "string",
      "const": "draft"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "allowed_tools": {
      "type": "array",
      "maxItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model_policy": {
      "type": "object",
      "required": [
        "provider",
        "model_id",
        "network_access"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "const": "local_deterministic"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "network_access": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    },
    "budget_policy": {
      "type": "object",
      "required": [
        "max_input_tokens",
        "max_output_tokens",
        "max_tool_requests"
      ],
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_requests": {
          "type": "integer",
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "prompt_reference": {
      "$ref": "#/$defs/SpecialAgentAssetId"
    },
    "rubric_reference": {
      "$ref": "#/$defs/SpecialAgentAssetId"
    },
    "critique_edges": {
      "type": "object",
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/SpecialAgentAssetId"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/SpecialAgentAssetId"
          }
        }
      },
      "additionalProperties": false
    },
    "max_refinement_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "production_activation_requested": {
      "type": "boolean",
      "const": false
    }
  },
  "$defs": {
    "CanonicalAgentId": {
      "type": "string",
      "pattern": "^specials\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "SpecialAgentAssetId": {
      "type": "string",
      "pattern": "^spagent\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "additionalProperties": false
}
